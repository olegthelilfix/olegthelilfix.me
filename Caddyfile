# Caddy config. Caddy provisions and renews Let's Encrypt TLS automatically
# once these names resolve (DNS A/AAAA → this server) and ports 80/443 are open.
# ACME contact email — override with {$ACME_EMAIL} in the environment.
{
	email {$ACME_EMAIL:hello@olegthelilfix.me}
}

(security) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		-Server
	}
}

# ContentQuest (repo olegthelilfix/SocialCapitalRPG): a separate Compose stack on
# this server. Its own internal Caddy serves the web bundle and the API over
# plain HTTP; it is reached over the shared external network `edge` by its alias
# only (both stacks have a service named `caddy`). If that stack is down, only
# this host answers 502.
game.olegthelilfix.me {
	import security
	reverse_proxy contentquest-edge:80
}

# Frontend (Next.js)
olegthelilfix.me {
	import security
	reverse_proxy web:3000
}

# www → apex redirect
www.olegthelilfix.me {
	redir https://olegthelilfix.me{uri} permanent
}
