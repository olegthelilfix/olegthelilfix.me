# Copy this file to `.env` (next to docker-compose.yml) and fill in the values.
#   cp .env.docker.example .env
# docker compose reads `.env` for these ${...} substitutions.

# GitHub Actions overrides these with private GHCR images and an immutable Git
# commit SHA. The defaults below are convenient for local `docker compose build`.
WEB_IMAGE=olegthelilfix-web
CMS_IMAGE=olegthelilfix-cms
MCP_IMAGE=olegthelilfix-mcp
IMAGE_TAG=local

# --- TLS / Caddy ------------------------------------------------------------
# Contact address Let's Encrypt uses for expiry notices.
ACME_EMAIL=hello@olegthelilfix.me

# --- Database ---------------------------------------------------------------
# The admin role only initializes and backs up the cluster. Strapi uses a
# separate least-privilege role. Generate two different passwords:
#   for k in POSTGRES_ADMIN_PASSWORD STRAPI_DATABASE_PASSWORD; do echo "$k=$(openssl rand -hex 24)"; done
POSTGRES_ADMIN_USERNAME=postgres
POSTGRES_ADMIN_PASSWORD=change-me-to-a-strong-admin-password
STRAPI_DATABASE_NAME=strapi
STRAPI_DATABASE_USERNAME=strapi
STRAPI_DATABASE_PASSWORD=change-me-to-a-strong-strapi-password

# --- Strapi secrets ---------------------------------------------------------
# Generate all of them at once:
#   APP_KEYS="$(openssl rand -base64 16),$(openssl rand -base64 16),$(openssl rand -base64 16),$(openssl rand -base64 16)"
#   for k in API_TOKEN_SALT ADMIN_JWT_SECRET TRANSFER_TOKEN_SALT JWT_SECRET ENCRYPTION_KEY; do echo "$k=$(openssl rand -base64 32)"; done
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# --- MCP -------------------------------------------------------------------
# Separate MCP gateway token. Use a Custom Strapi token with find/findOne;
# add create/update (never delete) only when MCP write mode is enabled.
MCP_ACCESS_TOKEN=change-me-to-at-least-32-random-bytes
STRAPI_API_TOKEN=paste-a-custom-strapi-api-token-here
MCP_WRITE_ENABLED=false
