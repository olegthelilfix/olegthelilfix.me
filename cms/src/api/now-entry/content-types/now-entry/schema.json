{
  "kind": "collectionType",
  "collectionName": "now_entries",
  "info": {
    "singularName": "now-entry",
    "pluralName": "now-entries",
    "displayName": "Now entry",
    "description": "A line in the current 'Now' snapshot"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "label": { "type": "string", "required": true },
    "text": { "type": "text" },
    "order": { "type": "integer", "default": 0 },
    "visibility": {
      "type": "enumeration",
      "enum": ["public", "unlisted", "private"],
      "default": "public",
      "required": true
    }
  }
}
