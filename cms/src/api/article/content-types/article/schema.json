{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "A published article, note or essay"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "kind": { "type": "string", "required": true },
    "title": { "type": "string", "required": true },
    "date": { "type": "string" },
    "readTime": { "type": "string" },
    "tags": { "type": "string" },
    "excerpt": { "type": "text" },
    "visibility": {
      "type": "enumeration",
      "enum": ["public", "unlisted", "private"],
      "default": "public",
      "required": true
    }
  }
}
