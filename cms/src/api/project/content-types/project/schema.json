{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "A personal technical project, finished or not"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "code": { "type": "string", "required": true, "unique": true },
    "name": { "type": "string", "required": true },
    "status": { "type": "string", "required": true },
    "description": { "type": "text" },
    "period": { "type": "string" },
    "tech": { "type": "string" },
    "learned": { "type": "text" },
    "coverFrom": { "type": "string" },
    "coverTo": { "type": "string" },
    "visibility": {
      "type": "enumeration",
      "enum": ["public", "unlisted", "private"],
      "default": "public",
      "required": true
    }
  }
}
