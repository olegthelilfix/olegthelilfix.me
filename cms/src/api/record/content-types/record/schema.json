{
  "kind": "collectionType",
  "collectionName": "records",
  "info": {
    "singularName": "record",
    "pluralName": "records",
    "displayName": "Record",
    "description": "A vinyl record in the collection"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "catalog": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "artist": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "releaseYear": {
      "type": "integer"
    },
    "edition": {
      "type": "string"
    },
    "boughtWhere": {
      "type": "string"
    },
    "favTrack": {
      "type": "string"
    },
    "note": {
      "type": "text"
    },
    "coverFrom": {
      "type": "string"
    },
    "coverTo": {
      "type": "string"
    },
    "visibility": {
      "type": "enumeration",
      "enum": ["public", "unlisted", "private"],
      "default": "public",
      "required": true
    }
  }
}
