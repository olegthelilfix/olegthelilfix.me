{
  "kind": "collectionType",
  "collectionName": "photos",
  "info": {
    "singularName": "photo",
    "pluralName": "photos",
    "displayName": "Photo",
    "description": "A selected photo with context"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "caption": { "type": "text", "required": true },
    "meta": { "type": "string" },
    "seed": { "type": "integer" },
    "visibility": {
      "type": "enumeration",
      "enum": ["public", "unlisted", "private"],
      "default": "public",
      "required": true
    }
  }
}
